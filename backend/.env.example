PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# JWT & Security
JWT_SECRET=super_secret_jwt_key_npa_2026_CHANGE_ME
JWT_REFRESH_SECRET=refresh_secret_jwt_key_npa_2026_CHANGE_ME
